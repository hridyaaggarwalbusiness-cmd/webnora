rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /portfolio/{media} {
   allow read: if request.auth != null && request.auth.token.admin == true;
   allow create: if request.auth != null && request.auth.token.admin == true && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm)');
  }
 }
}
