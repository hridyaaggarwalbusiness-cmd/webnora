rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function signed(){return request.auth != null;}
 function staff(){return signed() && request.auth.token.admin == true;}
 function own(){return signed() && resource.data.owner == request.auth.uid;}
 match /content/{id}{allow read: if id=='published' || staff(); allow write: if staff();}
 match /submissions/{uid}{allow create,update: if signed() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['at','ref']) && request.resource.data.at==request.time && (!exists(/databases/$(database)/documents/submissions/$(uid)) || request.time > resource.data.at + duration.value(2,'m'));}
 match /inquiries/{id}{
 allow read,update,delete: if staff();
 allow create: if signed() && request.resource.data.keys().hasOnly(['owner','name','email','phone','business','summary','status','created','attachment']) && request.resource.data.owner==request.auth.uid && request.resource.data.status=='New' && request.resource.data.created==request.time && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120 && request.resource.data.email.matches('.+@.+[.].+') && request.resource.data.email.size()<=254 && request.resource.data.business.size()<=150 && request.resource.data.phone.size()<=40 && (!('attachment' in request.resource.data) || (request.resource.data.attachment is string && request.resource.data.attachment.size()<=100000 && request.resource.data.attachment.matches('data:image/webp;base64,[a-zA-Z0-9+/=]+'))) && request.resource.data.summary.size()<=16000 && getAfter(/databases/$(database)/documents/submissions/$(request.auth.uid)).data.at==request.time && getAfter(/databases/$(database)/documents/submissions/$(request.auth.uid)).data.ref==id;
 }
 match /{kind}/{id}{
 allow read: if kind in ['projects','quotations','invoices','feedback','support','customers'] && (staff() || own());
 allow write: if kind in ['projects','quotations','invoices','feedback','support','customers'] && staff();
 allow create: if kind in ['feedback','support'] && signed() && request.resource.data.keys().hasOnly(['owner','message','type']) && request.resource.data.owner==request.auth.uid && request.resource.data.message is string && request.resource.data.message.size()>0 && request.resource.data.message.size()<=3000 && request.resource.data.type in ['Feedback','Revision','Support'];
 }
 }}
